# Auto detect text files and ensure LF line endings
* text=auto eol=lf

# Go
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Web
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf

# Config
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Docs
*.md text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
